# Mode selection: "simulation" (default) runs local fixtures; "live" requires every official setting below.
ALENIA_MODE=

# Databricks workspace host, e.g. https://adb-<workspace-id>.<cloud>.databricks.net
DATABRICKS_HOST=

# Databricks personal access token for the workspace.
DATABRICKS_TOKEN=

# SQL warehouse ID used by the SQL Statement Execution API.
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog catalog and schema used as the default namespace.
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# Mosaic AI Vector Search index name.
DATABRICKS_VECTOR_SEARCH_INDEX_NAME=

# Comma-separated list of columns the vector search index should return.
ALENIA_VECTOR_SEARCH_COLUMNS=

# OpenProject base URL.
OPENPROJECT_BASE_URL=

# OpenProject API key for the service account.
OPENPROJECT_API_KEY=

# OpenProject project identifier (e.g. "my-project").
OPENPROJECT_PROJECT_IDENTIFIER=

# Local development: keep external tracing off.
LANGSMITH_TRACING=false
